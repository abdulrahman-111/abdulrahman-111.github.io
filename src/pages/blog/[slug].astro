---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getPublishedEntries } from '../../lib/content';
import { getReadingTime } from '../../lib/reading-time';
import { getPostNeighbors, getRelatedPosts } from '../../lib/related-posts';

export async function getStaticPaths() {
  const posts = getPublishedEntries(await getCollection('blog'), import.meta.env.PROD);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, posts },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
  posts: CollectionEntry<'blog'>[];
}

const { post, posts } = Astro.props;
const { Content, headings } = await render(post);
const readingTime = getReadingTime(post.body ?? '');
const relatedPosts = getRelatedPosts(post, posts, 3);
const neighbors = getPostNeighbors(post, posts);
---

<ArticleLayout
  post={post}
  headings={headings}
  readingTime={readingTime}
  relatedPosts={relatedPosts}
  neighbors={neighbors}
>
  <Content />
</ArticleLayout>
