---
import { getCollection, type CollectionEntry } from 'astro:content';
import PostCard from '../../../components/PostCard.astro';
import SectionHeader from '../../../components/SectionHeader.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getPublishedEntries, slugify } from '../../../lib/content';

const categoryLabels: Record<string, string> = {
  devops: 'DevOps',
  'ml-systems': 'ML Systems',
  'systems-programming': 'Systems Programming',
};

export async function getStaticPaths() {
  const posts = getPublishedEntries(await getCollection('blog'), import.meta.env.PROD);
  const categories = [...new Set(posts.map((post) => post.data.category))];

  return categories.map((category) => ({
    params: { category: slugify(category) },
    props: {
      category,
      posts: posts.filter((post) => post.data.category === category),
    },
  }));
}

interface Props {
  category: string;
  posts: CollectionEntry<'blog'>[];
}

const { category, posts } = Astro.props;
const categoryLabel = categoryLabels[category] ?? category;
---

<BaseLayout
  title={`${categoryLabel} articles | Abdulrahman Gomaa Hassan`}
  description={`Articles in the ${categoryLabel} category.`}
>
  <section class="filtered page-shell">
    <a class="filtered__back" href="/blog/">← All articles</a>
    <SectionHeader
      eyebrow="Category filter"
      title={categoryLabel}
      description={`${posts.length} ${posts.length === 1 ? 'article' : 'articles'} in this static filter.`}
    />
    <div class="filtered__grid">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .filtered {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-6);
  }

  .filtered__back {
    width: fit-content;
    color: var(--color-cyan-strong);
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }

  .filtered__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 21rem), 1fr));
    gap: var(--space-3);
  }
</style>
