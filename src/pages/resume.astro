---
import ContactCta from '../components/ContactCta.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { siteConfig } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title={`Résumé | ${siteConfig.name}`}
  description="Download Abdulrahman Gomaa Hassan’s complete CV or a résumé focused on ML/AI or DevOps/Cloud."
>
  <section class="resume page-shell">
    <SectionHeader
      eyebrow="Role-aligned documents"
      title="Choose the résumé aligned with the role."
      description="Get the complete CV, or choose a version focused on ML/AI or DevOps/Cloud. All documents include the updated experience, internships, and submitted research."
    />
    <div class="resume__grid" data-reveal>
      {
        siteConfig.resumes.map((resume, index) => (
          <article>
            <p class="eyebrow">{index === 0 ? 'Full background' : 'Role focus'}</p>
            <h2>{resume.label}</h2>
            <p>{resume.focus}</p>
            <a
              class:list={['button-link', { 'button-link--primary': index === 0 }]}
              href={resume.href}
              download
            >
              Download {resume.label}
            </a>
          </article>
        ))
      }
    </div>
    <p class="resume__note">
      Updated November 2026. Each button downloads a standard PDF that you can also open directly in
      a browser.
    </p>
    <ContactCta />
  </section>
</BaseLayout>

<style>
  .resume {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-6);
  }
  .resume__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: var(--space-3);
  }
  .resume__grid article {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    min-height: 20rem;
    padding: var(--space-5);
    border: 1px solid transparent;
    border-radius: var(--radius);
    background: var(--color-surface);
    box-shadow: 0 0.625rem 1.875rem rgb(2 12 27 / 35%);
    transition:
      transform var(--transition-fast),
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }
  .resume__grid article:is(:hover, :focus-within) {
    transform: translateY(-0.25rem);
    border-color: var(--color-accent);
    box-shadow: 0 0.875rem 2.25rem rgb(2 12 27 / 45%);
  }
  .resume__grid h2,
  .resume__grid p {
    margin: 0;
  }
  .resume__grid h2 {
    font-size: clamp(1.8rem, 4vw, 2.7rem);
    line-height: 1.1;
  }
  .resume__grid p:not(.eyebrow),
  .resume__note {
    color: var(--color-text-muted);
  }
  .resume__grid .button-link {
    align-self: end;
    justify-self: start;
    margin-top: auto;
  }
  .resume__note {
    margin: calc(var(--space-4) * -1) 0 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .resume__grid article:is(:hover, :focus-within) {
      transform: none;
    }
  }
</style>
