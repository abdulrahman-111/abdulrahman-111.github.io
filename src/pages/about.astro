---
import ResearchList from '../components/ResearchList.astro';
import ContactCta from '../components/ContactCta.astro';
import SectionHeader from '../components/SectionHeader.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { siteConfig } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title={`About | ${siteConfig.name}`}
  description="The background, experience, education, and engineering interests behind Abdulrahman’s ML systems and DevOps work."
>
  <section class="about page-shell">
    <SectionHeader
      eyebrow="Profile · Cairo"
      title="Engineering across model and infrastructure boundaries."
      description="DevOps engineering, applied AI research, and Computer Engineering at Egypt University of Informatics. Explore my roles, internships, technical work, and academic background."
    />

    <nav class="section-nav" aria-label="About sections">
      <a href="#experience">Experience</a><a href="#research">Research</a><a href="#awards"
        >Awards</a
      ><a href="#education">Education</a><a href="#skills">Skills</a><a href="#leadership"
        >Leadership</a
      >
    </nav>
    <div class="about__intro panel" data-reveal>
      <p>
        I’m a Computer Engineering student at Egypt University of Informatics, a DevOps Engineer at
        Azouz Tech Group, and a Research Assistant at Nile University’s Center for Informatics
        Science. My work spans chest X-ray analysis, circular statistics, cloud automation, and
        Linux systems.
      </p>
      <p>
        I pair hands-on engineering with teaching and research: supporting more than 200 students as
        a Junior Teaching Assistant, contributing to two submitted journal manuscripts, and leading
        technical activities with the IEEE EUI Student Branch.
      </p>
    </div>

    <section id="experience" aria-labelledby="experience-title" data-reveal>
      <p class="eyebrow">Professional & research experience</p>
      <h2 id="experience-title">Experience</h2>
      <div class="timeline">
        {
          siteConfig.experience.map((item) => (
            <article class="timeline__item">
              <p>{item.period}</p>
              <h3>{item.organization}</h3>
              <strong>{item.role}</strong>
              <p>{item.summary}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section id="research" aria-labelledby="research-title" data-reveal>
      <p class="eyebrow">Research</p>
      <h2 id="research-title">Submitted manuscripts</h2>
      <ResearchList />
    </section>

    <section id="awards" aria-labelledby="awards-title" data-reveal>
      <p class="eyebrow">Recognition</p>
      <h2 id="awards-title">Hackathon awards</h2>
      <div class="record-grid">
        {
          siteConfig.awards.map((award) => (
            <article class="panel">
              <p class="status-label">
                {award.title} · {award.year}
              </p>
              <h3>
                <a href={award.href}>{award.event}</a>
              </h3>
              <p>{award.detail}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section id="education" aria-labelledby="education-title" data-reveal>
      <p class="eyebrow">Foundation</p>
      <h2 id="education-title">Education</h2>
      <div class="record-grid">
        {
          siteConfig.education.map((item) => (
            <article class="panel">
              <>
                <p class="status-label">{item.period}</p>
                <h3>{item.institution}</h3>
                <p>{item.detail}</p>
              </>
            </article>
          ))
        }
      </div>
    </section>

    <section id="skills" aria-labelledby="skills-title" data-reveal>
      <p class="eyebrow">Technical skills</p>
      <h2 id="skills-title">Skills</h2>
      <div class="skill-grid">
        {
          siteConfig.skillGroups.map((group) => (
            <article class="panel">
              <>
                <h3>{group.label}</h3>
                <p>{group.skills.join(' · ')}</p>
              </>
            </article>
          ))
        }
      </div>
    </section>

    <section
      id="leadership"
      class="leadership panel"
      aria-labelledby="leadership-title"
      data-reveal
    >
      <p class="eyebrow">Leadership & service</p>
      <h2 id="leadership-title">IEEE leadership</h2>
      <p>
        As Vice Head of the IEEE Computer Society at the EUI Student Branch (September
        2026–present), I have delivered technical sessions on Docker and GitHub Actions and
        contributed to organizing A3det Shai, an event with an audience of more than 500.
      </p>
      <p>
        Previously, as Secretary (December 2024–August 2026), I coordinated technical events,
        workshops, and hackathons reaching more than 100 students, and maintained meeting records,
        reports, and communication with members and faculty advisors.
      </p>
      <p>
        Outside project delivery, I’m interested in systems programming, applied machine learning,
        cloud platforms, technical communities, and the design decisions that make complex systems
        easier to operate.
      </p>
    </section>

    <section class="panel" aria-labelledby="languages-title" data-reveal>
      <p class="eyebrow">Languages</p>
      <h2 id="languages-title">English proficiency</h2>
      <p>Duolingo English Test: 115/160 · CEFR B2 · Taken 6 May 2025.</p>
      <a href="https://certs.duolingo.com/3nzcfz1rk1r8p002">View English test credential</a>
    </section>

    <section class="about__profiles panel" aria-labelledby="profiles-title" data-reveal>
      <p class="eyebrow">Public channels</p>
      <h2 id="profiles-title">Profiles and contact</h2>
      <p>Explore my public work and writing, or contact me directly by email.</p>
      <SocialLinks ariaLabel="About profile links" />
      <a href="https://orcid.org/0009-0000-0790-9506">ORCID: 0009-0000-0790-9506</a>
    </section>

    <ContactCta />
  </section>
</BaseLayout>

<style>
  .about {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-6);
  }
  .about section > h2,
  .leadership h2 {
    margin: var(--space-1) 0 var(--space-4);
    font-size: clamp(1.8rem, 4vw, 2.7rem);
  }
  .panel {
    padding: var(--space-4);
    border: 1px solid transparent;
    border-radius: var(--radius);
    background: var(--color-surface);
    box-shadow: 0 0.625rem 1.875rem rgb(2 12 27 / 35%);
  }
  .about__intro {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
    gap: var(--space-4);
    font-size: 1.08rem;
  }
  .panel > :first-child {
    margin-top: 0;
  }
  .panel > :last-child {
    margin-bottom: 0;
  }
  .panel p,
  .timeline__item > p:last-child {
    color: var(--color-text-muted);
  }
  .about__profiles {
    display: grid;
    gap: var(--space-2);
  }
  .about__profiles h2,
  .about__profiles p {
    margin: 0;
  }
  .timeline {
    display: grid;
    border-top: 1px solid var(--color-border);
  }
  .timeline__item {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 0.25rem var(--space-4);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--color-border);
  }
  .timeline__item > p:first-child {
    grid-row: span 3;
    margin: 0;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }
  .timeline__item h3,
  .timeline__item strong,
  .timeline__item > p:last-child {
    margin: 0;
  }
  .record-grid,
  .skill-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: var(--space-3);
  }
  .panel h3 {
    margin: var(--space-1) 0;
  }
  @media (max-width: 40rem) {
    .timeline__item {
      grid-template-columns: 1fr;
    }
    .timeline__item > p:first-child {
      grid-row: auto;
    }
  }
</style>
