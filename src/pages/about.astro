---
import ContactCta from '../components/ContactCta.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { siteConfig } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title={`About | ${siteConfig.name}`}
  description="The background, experience, education, and engineering interests behind Abdulrahman’s ML systems and DevOps work."
>
  <section class="about page-shell">
    <SectionHeader
      eyebrow="Profile // Cairo"
      title="Engineering across model and infrastructure boundaries."
      description="I approach intelligent applications as systems: models, data paths, deployment boundaries, observability, and the low-level behavior underneath them all matter."
    />

    <div class="about__intro panel">
      <p>
        I’m a Computer Engineering student at Egypt University of Informatics, building toward roles
        where machine learning and platform engineering meet. My work ranges from computer-vision
        workflows and decision-support systems to Kubernetes delivery, cloud automation, and Linux
        process management.
      </p>
      <p>
        I care about explicit ownership, repeatable delivery, and technical explanations that
        separate verified contribution from whole-project capability.
      </p>
    </div>

    <section aria-labelledby="experience-title">
      <p class="eyebrow">Operating history</p>
      <h2 id="experience-title">Experience</h2>
      <div class="timeline">
        {
          siteConfig.experience.map((item) => (
            <article class="timeline__item">
              <p>{item.period}</p>
              <h3>{item.organization}</h3>
              <strong>{item.role}</strong>
              <p>{item.summary}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section aria-labelledby="education-title">
      <p class="eyebrow">Foundation</p>
      <h2 id="education-title">Education</h2>
      <div class="record-grid">
        {
          siteConfig.education.map((item) => (
            <article class="panel">
              <>
                <p class="status-label">{item.period}</p>
                <h3>{item.institution}</h3>
                <p>{item.detail}</p>
              </>
            </article>
          ))
        }
      </div>
    </section>

    <section aria-labelledby="skills-title">
      <p class="eyebrow">Tooling map</p>
      <h2 id="skills-title">Skills</h2>
      <div class="skill-grid">
        {
          siteConfig.skillGroups.map((group) => (
            <article class="panel">
              <>
                <h3>{group.label}</h3>
                <p>{group.skills.join(' · ')}</p>
              </>
            </article>
          ))
        }
      </div>
    </section>

    <section class="leadership panel" aria-labelledby="leadership-title">
      <p class="eyebrow">Community layer</p>
      <h2 id="leadership-title">IEEE leadership</h2>
      <p>
        As Secretary of the IEEE Computer Society at the EUI Student Branch, I coordinate technical
        events, workshops, and hackathons reaching more than 100 students, while maintaining the
        documentation and communication that keeps the organization operating.
      </p>
      <p>
        Outside project delivery, I’m interested in systems programming, applied machine learning,
        cloud platforms, technical communities, and the design decisions that make complex systems
        easier to operate.
      </p>
    </section>

    <ContactCta />
  </section>
</BaseLayout>

<style>
  .about {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-6);
  }
  .about section > h2,
  .leadership h2 {
    margin: var(--space-1) 0 var(--space-4);
    font-size: clamp(1.8rem, 4vw, 2.7rem);
  }
  .panel {
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  .about__intro {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
    gap: var(--space-4);
    font-size: 1.08rem;
  }
  .panel > :first-child {
    margin-top: 0;
  }
  .panel > :last-child {
    margin-bottom: 0;
  }
  .panel p,
  .timeline__item > p:last-child {
    color: var(--color-text-muted);
  }
  .timeline {
    display: grid;
    border-top: 1px solid var(--color-border);
  }
  .timeline__item {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 0.25rem var(--space-4);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--color-border);
  }
  .timeline__item > p:first-child {
    grid-row: span 3;
    margin: 0;
    color: var(--color-cyan);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }
  .timeline__item h3,
  .timeline__item strong,
  .timeline__item > p:last-child {
    margin: 0;
  }
  .record-grid,
  .skill-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: var(--space-3);
  }
  .panel h3 {
    margin: var(--space-1) 0;
  }
  @media (max-width: 40rem) {
    .timeline__item {
      grid-template-columns: 1fr;
    }
    .timeline__item > p:first-child {
      grid-row: auto;
    }
  }
</style>
