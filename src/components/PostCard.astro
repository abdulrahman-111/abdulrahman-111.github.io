---
import type { CollectionEntry } from 'astro:content';
import { getReadingTime } from '../lib/reading-time';
import TagList from './TagList.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  headingLevel?: 'h2' | 'h3';
}

const { post, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
const readingTime = getReadingTime(post.body ?? '');
const published = post.data.published.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<article class="post-card">
  <div class="post-card__meta">
    <time datetime={post.data.published.toISOString()}>{published}</time>
    <span>{readingTime} min read</span>
  </div>
  <Heading><a href={`/blog/${post.id}/`}>{post.data.title}</a></Heading>
  <p>{post.data.description}</p>
  <TagList tags={post.data.tags} linked />
  <a class="post-card__link" href={`/blog/${post.id}/`}>
    Read article <span aria-hidden="true">→</span>
  </a>
</article>

<style>
  .post-card {
    display: grid;
    gap: var(--space-3);
    min-height: 100%;
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .post-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    color: var(--color-cyan);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    text-transform: uppercase;
  }

  .post-card__meta span::before {
    margin-right: var(--space-2);
    color: var(--color-border-strong);
    content: '//';
  }

  .post-card :is(h2, h3) {
    margin: 0;
    font-size: clamp(1.3rem, 3vw, 1.75rem);
    line-height: 1.2;
  }

  .post-card :is(h2, h3) a {
    text-decoration: none;
  }

  .post-card > p {
    margin: 0;
    color: var(--color-text-muted);
  }

  .post-card__link {
    align-self: end;
    color: var(--color-cyan-strong);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 700;
  }
</style>
