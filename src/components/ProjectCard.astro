---
import type { CollectionEntry } from 'astro:content';
import TagList from './TagList.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  headingLevel?: 'h2' | 'h3';
}

const { project, headingLevel: Heading = 'h2' } = Astro.props;
---

<article class="project-card">
  <div class="project-card__meta">
    <span>{project.data.domain}</span>
    <span>{project.data.status ?? project.data.period}</span>
    <span>{project.data.collaborative ? 'Collaborative' : 'Solo'}</span>
  </div>
  <Heading><a href={`/projects/${project.id}/`}>{project.data.title}</a></Heading>
  <p>{project.data.summary}</p>
  {
    project.data.collaborative && (
      <p class="project-card__contribution">
        <strong>Contribution:</strong> {project.data.contribution[0]}
      </p>
    )
  }
  <TagList tags={project.data.tags.slice(0, 4)} />
  <a
    class="project-card__link"
    href={`/projects/${project.id}/`}
    aria-label={`Read ${project.data.title} case study`}>Read case study</a
  >
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    height: 100%;
    padding: var(--space-4);
    border: 1px solid transparent;
    border-radius: var(--radius);
    background: var(--color-surface);
    box-shadow: 0 0.625rem 1.875rem rgb(2 12 27 / 35%);
    transition:
      transform var(--transition-fast),
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .project-card:is(:hover, :focus-within) {
    transform: translateY(-0.25rem);
    border-color: var(--color-accent);
    box-shadow: 0 0.875rem 2.25rem rgb(2 12 27 / 45%);
  }

  .project-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    text-transform: uppercase;
  }

  .project-card__meta span:not(:first-child)::before {
    margin-right: var(--space-2);
    color: var(--color-border-strong);
    content: '·';
  }

  .project-card :is(h2, h3) {
    margin: 0;
    font-size: clamp(1.45rem, 3vw, 2rem);
    line-height: 1.15;
  }

  .project-card :is(h2, h3) a {
    text-decoration: none;
  }

  .project-card > p {
    margin: 0;
    color: var(--color-text-muted);
  }

  .project-card .project-card__contribution {
    padding-left: var(--space-3);
    border-left: 2px solid var(--color-accent);
    color: var(--color-text);
    font-size: 0.9rem;
  }

  .project-card :global(.tag-list) {
    margin-top: auto;
  }

  .project-card__link {
    align-self: start;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 700;
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card:is(:hover, :focus-within) {
      transform: none;
    }
  }
</style>
