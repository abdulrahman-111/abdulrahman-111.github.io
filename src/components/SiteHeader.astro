---
import { siteConfig } from '../data/site';

const currentPath = Astro.url.pathname;
const isCurrentRoute = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(href);
---

<header class="site-header">
  <div class="page-shell site-header__inner">
    <a class="site-header__identity" href="/" aria-label={`${siteConfig.name} home`}>
      <span aria-hidden="true">AG</span>
      <span class="site-header__identity-name">{siteConfig.name}</span>
    </a>

    <button
      class="site-header__menu-toggle"
      type="button"
      aria-controls="primary-navigation"
      aria-expanded="false"
    >
      <span aria-hidden="true">☰</span>
      <span>Menu</span>
    </button>

    <nav id="primary-navigation" class="site-header__nav" aria-label="Primary navigation">
      <ul>
        {
          siteConfig.navigation.map((item) => (
            <li>
              <a
                class:list={{ 'site-header__resume-action': item.href === '/resume/' }}
                href={item.href}
                aria-current={isCurrentRoute(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.site-header__menu-toggle');
  const navigation = document.querySelector<HTMLElement>('#primary-navigation');
  const header = document.querySelector<HTMLElement>('.site-header');

  if (toggle && navigation && header) {
    const updateHeader = () => header.classList.toggle('is-scrolled', window.scrollY > 12);
    updateHeader();
    window.addEventListener('scroll', updateHeader, { passive: true });

    const closeNavigation = () => {
      toggle.setAttribute('aria-expanded', 'false');
      navigation.classList.remove('is-open');
    };

    toggle.addEventListener('click', () => {
      const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isExpanded));
      navigation.classList.toggle('is-open', !isExpanded);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        closeNavigation();
        toggle.focus();
      }
    });

    navigation.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a')) closeNavigation();
    });

    header.classList.add('is-navigation-enhanced');
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--color-border);
    background: rgb(10 25 47 / 88%);
    transition:
      background-color 220ms ease,
      box-shadow 220ms ease,
      backdrop-filter 220ms ease;
  }

  .site-header.is-scrolled {
    background: rgb(10 25 47 / 76%);
    box-shadow: 0 0.6rem 1.8rem rgb(2 12 27 / 28%);
    backdrop-filter: blur(0.8rem);
  }

  .site-header__inner {
    display: flex;
    min-height: var(--site-header-height);
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .site-header__identity {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
  }

  .site-header__identity [aria-hidden='true'] {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 1px solid var(--color-accent);
    border-radius: var(--radius);
    color: var(--color-accent);
  }

  .site-header__menu-toggle {
    display: none;
    align-items: center;
    gap: 0.4rem;
    border: 1px solid var(--color-border-strong);
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding: 0.5rem 0.65rem;
  }

  .site-header__nav {
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .site-header.is-navigation-enhanced .site-header__menu-toggle {
    display: inline-flex;
  }

  .site-header.is-navigation-enhanced .site-header__nav {
    position: absolute;
    top: var(--site-header-height);
    right: 1rem;
    left: 1rem;
    z-index: 2;
    width: auto;
    visibility: hidden;
    pointer-events: none;
    opacity: 0;
    transform: translateY(-0.5rem);
    transition:
      opacity 220ms ease,
      transform 220ms ease,
      visibility 0s linear 220ms;
  }

  .site-header.is-navigation-enhanced .site-header__nav.is-open {
    visibility: visible;
    pointer-events: auto;
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0s;
  }

  .site-header__nav ul {
    display: grid;
    gap: 0.2rem;
    margin: 0;
    padding: var(--space-2);
    list-style: none;
  }

  .site-header__nav a {
    display: block;
    padding: 0.55rem;
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    text-decoration: none;
  }

  .site-header__nav a:hover {
    background: var(--color-surface-raised);
    color: var(--color-accent);
  }

  .site-header__nav a[aria-current='page'] {
    color: var(--color-accent);
  }

  .site-header__resume-action {
    border: 1px solid var(--color-accent);
    border-radius: var(--radius);
    color: var(--color-accent);
  }

  @media (min-width: 48rem) {
    .site-header__menu-toggle,
    .site-header.is-navigation-enhanced .site-header__menu-toggle {
      display: none;
    }

    .site-header__nav,
    .site-header.is-navigation-enhanced .site-header__nav {
      position: static;
      width: auto;
      border: 0;
      visibility: visible;
      pointer-events: auto;
      opacity: 1;
      transform: none;
      background: transparent;
      transition: none;
    }

    .site-header__nav ul {
      display: flex;
      gap: 0.15rem;
      padding: 0;
    }

    .site-header__nav a {
      padding-inline: 0.55rem;
    }

    .site-header__resume-action {
      margin-left: 0.25rem;
    }
  }

  @media (max-width: 34rem) {
    .site-header__identity-name {
      display: none;
    }
  }
</style>
