---
import type { z } from 'astro/zod';
import type { certificationSchema } from '../lib/content-schemas';

interface Props {
  certification: z.infer<typeof certificationSchema>;
  headingLevel?: 'h2' | 'h3';
}

const { certification, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const issued = certification.issued
  ? certification.issued.toLocaleDateString('en-US', {
      month: 'short',
      year: 'numeric',
      timeZone: 'UTC',
    })
  : undefined;
---

<article class="credential-card">
  <img
    src={certification.previewPath}
    alt={`${certification.name} certificate preview with private identifiers redacted`}
    loading="lazy"
    width="1200"
    height="900"
  />
  <div class="credential-card__body">
    <p class="credential-card__meta">{certification.issuer}{issued && ` // ${issued}`}</p>
    <Heading>{certification.name}</Heading>
    <ul aria-label="Credential skills">
      {certification.skills.map((skill) => <li>{skill}</li>)}
    </ul>
    {
      certification.verificationUrl && (
        <a href={certification.verificationUrl}>
          Public verification <span aria-hidden="true">↗</span>
        </a>
      )
    }
  </div>
</article>

<style>
  .credential-card {
    display: grid;
    min-height: 100%;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .credential-card img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: contain;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-canvas);
  }

  .credential-card__body {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding: var(--space-3);
  }

  .credential-card__meta {
    margin: 0;
    color: var(--color-cyan);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
  }

  .credential-card :is(h2, h3) {
    margin: 0;
    font-size: 1.15rem;
    line-height: 1.25;
  }

  .credential-card ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .credential-card li {
    padding: 0.15rem 0.4rem;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .credential-card a {
    color: var(--color-cyan-strong);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }
</style>
