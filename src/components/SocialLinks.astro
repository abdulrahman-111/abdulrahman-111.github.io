---
import { siteConfig } from '../data/site';

interface Props {
  class?: string;
  ariaLabel?: string;
}

const { class: className, ariaLabel = 'Public profiles and contact links' } = Astro.props;
const links = [
  { label: 'Email', href: `mailto:${siteConfig.email}`, external: false },
  { label: 'GitHub', href: siteConfig.social.github, external: true },
  { label: 'LinkedIn', href: siteConfig.social.linkedin, external: true },
  { label: 'Kaggle', href: siteConfig.social.kaggle, external: true },
  { label: 'Medium', href: siteConfig.social.medium, external: true },
];
---

<ul class:list={['social-links', className]} aria-label={ariaLabel}>
  {
    links.map(({ label, href, external }) => (
      <li>
        <a
          href={href}
          target={external ? '_blank' : undefined}
          rel={external ? 'noreferrer' : undefined}
        >
          {label}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    align-items: center;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .social-links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    color: var(--color-cyan);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-underline-offset: 0.25em;
  }

  .social-links a:hover {
    color: var(--color-amber);
  }
</style>
