---
import { slugify } from '../lib/content';

interface Props {
  tags: readonly string[];
  linked?: boolean;
}

const { tags, linked = false } = Astro.props;
---

<ul class="tag-list" aria-label="Tags">
  {
    tags.map((tag) => (
      <li>{linked ? <a href={`/blog/tag/${slugify(tag)}/`}>{tag}</a> : <span>{tag}</span>}</li>
    ))
  }
</ul>

<style>
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag-list :is(a, span) {
    display: inline-flex;
    padding: 0.22rem 0.5rem;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.35;
    text-decoration: none;
  }

  .tag-list a:hover {
    border-color: var(--color-cyan);
    color: var(--color-cyan-strong);
  }
</style>
